# No Easypanel (serviço → Environment):
# 1) Cole estas variáveis
# 2) Ative "Create env file"
# 3) Env file path = .env
# 4) Salve e faça redeploy
# Sem o Create env file, o cron a cada minuto pode não ver URL/TOKEN/WhatsApp.

# URL do painel (com ou sem /api)
EASYPANEL_URL=https://panel.seudominio.com

# API key do usuário: Settings → Server → Users → Generate API Key
# Docs: https://easypanel.io/docs/api
EASYPANEL_TOKEN=seu_token_aqui

# Intervalo em que ESTE container verifica os backups (não é o horário do backup).
# Padrão: a cada minuto, para respeitar o Cron de cada config no EasyPanel.
CRON_SCHEDULE=* * * * *
TZ=America/Sao_Paulo

# true = só dispara quando o Cron da config no EasyPanel bate com o horário atual
# false = dispara todos os enabled a cada tick do CRON_SCHEDULE (modo antigo)
RESPECT_BACKUP_CRON=true

# true = executa uma vez ao subir o container (ignora cron das configs; útil para testar)
RUN_ON_START=true

# true = só configs com enabled=true; false = todas
ONLY_ENABLED=true

# true = loga também os SKIP "not due" a cada minuto (barulhento)
# VERBOSE_POLL=false

# Opcional: filtrar (vírgula). Vazio = todos
# EASYPANEL_PROJECTS=aplicativos
# EASYPANEL_SERVICES=arksales-pgvector

# true = só lista o que rodaria, sem POST runDatabaseBackup
DRY_RUN=false

# --- WhatsApp Cloud API (Meta) — notifica só quando houver falha ---
# Meta Business Suite → WhatsApp → API Setup
WHATSAPP_SYSTEM_PHONE_NUMBER_ID=
WHATSAPP_SYSTEM_ACCESS_TOKEN=
# Número que recebe o alerta (DDI+DDD+número, só dígitos). Ex: 5511999999999
WHATSAPP_NUMBER_TO=

# Opcionais (defaults abaixo)
# WHATSAPP_TEMPLATE_NAME=system_alert
# WHATSAPP_TEMPLATE_LANG=pt_BR
# WHATSAPP_API_VERSION=v21.0

# ============================================================
# TEMPLATE A CRIAR NO META (WhatsApp Manager → Message templates)
# ============================================================
# Nome:     system_alert
# Categoria: UTILITY (Utilidade)
# Idioma:   Portuguese (BR)  → código pt_BR
#
# Corpo (Body) — exatamente 1 variável {{1}}:
#
#   Alerta do sistema: {{1}}
#
# Exemplos de {{1}} ao criar o template (Meta exige exemplos):
#   Easypanel backups: 1 falha(s). runDatabaseBackup aplicativos/arksales-pgvector db=arksales dest=cloudflare id=abc: HTTP 500
#
# Depois da aprovação do template, as falhas de backup disparam essa mensagem.
# ============================================================
